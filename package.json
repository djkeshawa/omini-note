{
  "name": "vispnote",
  "version": "0.2.5",
  "desktopName": "vispnote.desktop",
  "description": "VispNote \u2014 a local-first, block-based note-taking desktop app",
  "license": "Apache-2.0",
  "author": {
    "name": "djkeshawa",
    "url": "https://github.com/djkeshawa"
  },
  "files": [
    "vispnote.html",
    "main.js",
    "preload.js",
    "assets/",
    "build/renderer/",
    "lib/",
    "bin/",
    "src/",
    "scripts/linux-after-install.sh",
    "scripts/before-pack.js",
    "scripts/build-renderer.js",
    "scripts/verify-packaged-renderer.js",
    "electron-builder.yml"
  ],
  "homepage": "https://github.com/djkeshawa/visp-note#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/djkeshawa/visp-note.git"
  },
  "main": "main.js",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "build:renderer": "node scripts/build-renderer.js",
    "verify:package-renderer": "node scripts/verify-packaged-renderer.js",
    "verify:release-artifacts": "node scripts/release-tools/verify-release-artifacts.js",
    "prepare:release-artifacts": "node scripts/release-tools/prepare-artifacts.js",
    "check:release-tag": "node scripts/release-tools/validate-release-tag.js",
    "check:architecture": "node scripts/check-architecture.js",
    "check:main": "npm run lint -- --quiet=false && npm run check:architecture && node --check main.js && node --check preload.js && node --check lib/store.js && node --check lib/index.js && node --check lib/ai.js && node --check lib/ai/embeddings.js && node --check lib/ai/operations.js && node --check lib/ai/providers.js && node --check lib/ai/research.js && node --check lib/ai/sse.js && node --check lib/ai/summaries.js && node --check lib/ollama.js && node --check lib/integrations/zotero/client.js && node --check lib/integrations/memory/client.js && node --check lib/integrations/telemetry/featureUsage.js && node --check lib/integrations/ai/providerTransport.js && node --check lib/integrations/ai/toolSchemas.js && node --check lib/memoryLinks.js && node --check lib/memoryIndexCache.js && node --check lib/vaultWatcher.js && node --check lib/quitPersistence.js && node --check lib/mcp/server.js && node --check lib/mcp/tools.js && node --check bin/vispnote-mcp.js",
    "test:editor": "node scripts/run-node-tests.js",
    "mcp": "node bin/vispnote-mcp.js",
    "regression:renderer": "npm run build:renderer && electron --no-sandbox scripts/regression-electron.js",
    "regression:ai": "npm run build:renderer && electron --no-sandbox scripts/ai-regression-electron.js",
    "smoke:electron": "npm run build:renderer && electron --no-sandbox scripts/smoke-electron.js",
    "regression:memory": "node scripts/memory-regression.js",
    "benchmark:10k": "node scripts/run-10000-note-benchmark.js",
    "test:all": "npm run check:main && npm run test:editor && npm run smoke:electron && npm run regression:renderer && npm run regression:ai",
    "test:all:with-memory": "npm run test:all && npm run regression:memory",
    "prebuild": "npm run build:renderer",
    "build": "electron-builder --publish never",
    "prebuild:mac": "npm run build:renderer",
    "build:mac": "electron-builder --mac --publish never",
    "prebuild:linux": "npm run build:renderer",
    "build:linux": "electron-builder --linux --publish never",
    "prebuild:win": "npm run build:renderer",
    "build:win": "electron-builder --win nsis --publish never",
    "prebuild:win:portable": "npm run build:renderer",
    "build:win:portable": "electron-builder --win portable --publish never",
    "start": "npm run build:renderer && electron .",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint . --max-warnings 0",
    "coverage": "ELECTRON_RUN_AS_NODE=1 electron --test --experimental-test-coverage tests/*.test.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^41.10.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9",
    "katex": "^0.16.47",
    "mermaid": "^11.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sqlite-vec": "^0.1.9"
  }
}
