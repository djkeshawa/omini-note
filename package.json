{
  "name": "vispnote",
  "version": "0.1.13",
  "description": "VispNote — a local-first, block-based note-taking desktop app",
  "license": "Apache-2.0",
  "author": {
    "name": "djkeshawa",
    "url": "https://github.com/djkeshawa"
  },
  "files": [
    "OminiNote.html",
    "main.js",
    "preload.js",
    "assets/",
    "lib/",
    "src/",
    "scripts/linux-after-install.sh",
    "electron-builder.yml"
  ],
  "homepage": "https://github.com/djkeshawa/visp-note#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/djkeshawa/visp-note.git"
  },
  "main": "main.js",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "check:main": "node --check main.js && node --check preload.js && node --check lib/store.js && node --check lib/index.js && node --check lib/ai.js && node --check lib/ollama.js",
    "test:editor": "node tests/editor-ops.test.js",
    "smoke:electron": "electron --no-sandbox scripts/smoke-electron.js",
    "build": "electron-builder --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:win": "electron-builder --win nsis --publish never",
    "build:win:portable": "electron-builder --win portable --publish never",
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@babel/standalone": "^7.29.0",
    "better-sqlite3": "^12.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sqlite-vec": "^0.1.9"
  }
}
